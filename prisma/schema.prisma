generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String    @id @default(cuid())
  name                       String
  email                      String    @unique
  emailVerified              Boolean   @default(false)
  image                      String?
  role                       String    @default("user")
  status                     String    @default("active")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  twoFactorEnabled           Boolean?  @default(false)
  termsAcceptedAt            DateTime?
  termsVersion               String?
  mustChangePassword         Boolean   @default(false)
  temporaryPasswordExpiresAt DateTime?

  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  activityLogs        ActivityLog[]
  operationalLogs     OperationalLog[]
  submittedVersions   SkillVersion[]
  analysisJobs        AnalysisJob[]
  blockedRepositories BlockedRepository[]

  @@index([createdAt, id])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twoFactor")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String // e.g., "login", "logout", "profile_update", "password_change", "2fa_enabled", etc.
  details   String? // JSON string with additional details
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("activity_log")
}

model OperationalLog {
  id        String   @id @default(cuid())
  level     String // info | warn | error | critical
  source    String // low-cardinality origin, e.g. "emails"
  code      String // stable identifier, e.g. "email.delivery.sent"
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([level, createdAt])
  @@map("operational_log")
}

enum AnalysisJobKind {
  analysis
  fingerprint_check
}

enum AnalysisJobStatus {
  queued
  running
  done
  failed
}

enum FindingSeverity {
  critical
  high
  medium
  low
}

enum Verdict {
  dangerous
  review
  no_serious_findings
}

enum FileReview {
  source
  decompiled
  unreviewable
}

enum FileOrigin {
  skill
  plugin
  readme
  remote
}

model Skill {
  id                     String         @id @default(cuid())
  owner                  String
  repo                   String
  displayOwner           String?
  displayRepo            String?
  path                   String
  name                   String
  description            String
  slug                   String         @unique
  hiddenAt               DateTime?
  latestVersionId        String?
  latestVerdict          Verdict?
  latestAnalyzedAt       DateTime?
  latestWarningCount     Int?
  latestHasRemoteScripts Boolean?
  searchText             String         @default("")
  createdAt              DateTime       @default(now())
  versions               SkillVersion[]

  @@unique([owner, repo, path])
  @@index([latestAnalyzedAt])
  @@index([name])
  @@index([latestWarningCount])
  @@index([latestVerdict])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("skill")
}

model SkillVersion {
  id               String        @id @default(cuid())
  skillId          String
  commitSha        String
  submittedRef     String
  filesFingerprint String
  fingerprint      String?
  hasRemoteScripts Boolean       @default(false)
  sourceFiles      Json          @default("[]")
  verdict          Verdict?
  analyzedAt       DateTime?
  report           Json?
  submittedById    String?
  createdAt        DateTime      @default(now())
  skill            Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  submittedBy      User?         @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  analysisJobs     AnalysisJob[]
  files            VersionFile[]
  findings         Finding[]

  @@unique([skillId, fingerprint])
  @@index([skillId, filesFingerprint])
  @@map("skill_version")
}

model VersionFile {
  id            String       @id @default(cuid())
  versionId     String
  path          String
  origin        FileOrigin
  blobSha       String?
  contentSha256 String
  remoteUrl     String?
  downloadedAt  DateTime?
  kind          String
  language      String?
  lineCount     Int
  byteSize      Int
  review        FileReview
  flags         String[]
  version       SkillVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, path])
  @@map("version_file")
}

model Finding {
  id        String          @id @default(cuid())
  versionId String
  ruleId    String
  category  String
  severity  FindingSeverity
  declared  Boolean         @default(false)
  origin    String          @default("rules")
  filePath  String
  line      Int
  title     String
  evidence  String
  createdAt DateTime        @default(now())
  version   SkillVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, severity])
  @@map("finding")
}

model AnalysisJob {
  id               String            @id @default(cuid())
  versionId        String
  kind             AnalysisJobKind
  status           AnalysisJobStatus @default(queued)
  step             String?
  progressCurrent  Int?
  progressTotal    Int?
  attempts         Int               @default(0)
  failureReason    String?
  userId           String?
  creditMonth      String?
  creditReturnedAt DateTime?
  createdAt        DateTime          @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?
  heartbeatAt      DateTime?
  version          SkillVersion      @relation(fields: [versionId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, creditMonth])
  @@map("analysis_job")
}

model BlockedRepository {
  id          String   @id @default(cuid())
  owner       String
  repo        String
  reason      String
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([owner, repo])
  @@map("blocked_repository")
}
