# Database
# PostgreSQL connection string; replace with a database you control.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"
# Set to true to have bun dev start local PostgreSQL in Docker automatically.
DOCKER_DATABASE=false
# Docker Compose local database (Compose sets this URL for the app service):
# postgresql://rapidauth:rapidauth@localhost:5432/rapidauth?sslmode=disable

# Better Auth
# Replace with a unique 64-character secret from: openssl rand -hex 32
BETTER_AUTH_SECRET="replace-with-a-unique-random-64-character-hex-secret"
# Public base URL of this app.
BETTER_AUTH_URL="http://localhost:3000"

# Email (Resend)
# Replace with an API key from your Resend account.
RESEND_API_KEY="re_replace_with_your_resend_key"
# Use an address on a domain verified with Resend for production.
FROM_EMAIL="RapidAuth <noreply@example.com>"

# Cloudflare Turnstile
# Public site key; leave empty for local next dev or use a test key locally.
# Production builds require a real key. Test keys: docs/en/02-turnstile.md
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Server secret key; leave empty for local next dev, never expose it to the client.
TURNSTILE_SECRET_KEY=""

# OAuth Providers
# Google OAuth client ID; optional unless Google sign-in is enabled.
GOOGLE_CLIENT_ID=""
# Google OAuth client secret; optional unless Google sign-in is enabled.
GOOGLE_CLIENT_SECRET=""
# GitHub OAuth client ID; optional unless GitHub sign-in is enabled.
GITHUB_CLIENT_ID=""
# GitHub OAuth client secret; optional unless GitHub sign-in is enabled.
GITHUB_CLIENT_SECRET=""
# Show the Google sign-in button only when true.
NEXT_PUBLIC_GOOGLE_ENABLED="false"
# Show the GitHub sign-in button only when true.
NEXT_PUBLIC_GITHUB_ENABLED="false"

# Seed
# Optional initial admin email; defaults to admin@admin.com.
SEED_ADMIN_EMAIL="admin@admin.com"
# Leave commented to generate a random password once, or uncomment and replace with 8+ characters.
# SEED_ADMIN_PASSWORD="replace-with-a-unique-password"

# Themes
# Optional token for premium themes; the selector prompts and saves it in .env.local.
GITHUB_TOKEN=""
