#!/usr/bin/env sh

echo "Running pre-commit checks..."

echo "1/5 Checking exact dependency versions..."
bun run deps:check || exit 1

echo "2/5 Running lint..."
bun run lint || exit 1

echo "3/5 Running typecheck..."
bun run typecheck || exit 1

echo "4/5 Running build..."
bun run build || exit 1

if git diff --cached --name-only | grep -q '^worker/'; then
  echo "5/5 Running worker checks..."
  (cd worker && uv run ruff check && uv run ruff format --check && uv run pytest -m "not db") || exit 1
else
  echo "5/5 Worker unchanged, skipping"
fi

echo "All checks passed!"
