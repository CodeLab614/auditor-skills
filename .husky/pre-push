#!/usr/bin/env sh

echo "Running pre-push checks..."

if [ -n "$(git status --porcelain)" ]; then
  echo "Commit or stash your changes before pushing: the E2E suite must test exactly what you push."
  git status --short
  exit 1
fi

if ! docker info > /dev/null 2>&1; then
  echo "Docker is not running. Start Docker Desktop: the E2E suite needs a disposable Postgres and an S3 mock."
  exit 1
fi

echo "Running E2E suite (about 3 minutes)..."
bun run test:e2e || exit 1

echo "All pre-push checks passed!"
